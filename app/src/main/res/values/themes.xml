<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Valoralo" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen (androidx core-splashscreen): the launcher logo on the brand blue, then the app theme. -->
    <style name="Theme.Valoralo.Inicio" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Valoralo</item>
    </style>
</resources>
