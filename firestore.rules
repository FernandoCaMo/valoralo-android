rules_version = '2';

// Valoralo — Firestore security rules (docs/02-arquitectura-y-datos.md).
// The catalogue, stats, rol and verificado are written only by the backend
// (Admin SDK / Cloud Functions), which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrators carry the custom claim admin = true (tools/admin/hacer_admin.py).
    function esAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Catalogue of centros, including stats: public read, no client writes.
    match /centros/{codigo} {
      allow read: if true;
      allow write: if false;

      // Reviews: anyone can read the published ones (queries must filter by
      // estado == "PUBLICADA"); the author can also read their own while it is under
      // review. They are written only by the publicarValoracion function (filter, role
      // from the profile); the author can delete their own.
      match /valoraciones/{uid} {
        allow read: if resource.data.estado == "PUBLICADA"
          || (request.auth != null && request.auth.uid == uid);
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if false;

        // Likes: one per user and review (the document id is the user's uid). Written by the
        // app; the review's nLikes counter only by alCambiarLike. Not on your own review, only
        // on published ones, and at most config/likes.maxPorHora per hour (default 60).
        match /likes/{liker} {
          allow read: if request.auth != null && request.auth.uid == liker;
          allow delete: if request.auth != null && request.auth.uid == liker;
          allow update: if false;
          allow create: if request.auth != null
            && request.auth.uid == liker
            && liker != uid
            && get(/databases/$(database)/documents/centros/$(codigo)/valoraciones/$(uid)).data.estado == "PUBLICADA"
            && request.resource.data.keys().hasOnly(['uid', 'codigo', 'fecha'])
            && request.resource.data.keys().hasAll(['uid', 'codigo', 'fecha'])
            && request.resource.data.uid == liker
            && request.resource.data.codigo == codigo
            && request.resource.data.fecha == request.time
            && limiteSubeEnEsteLote(liker);
        }
      }
    }

    // The like must be written together with its user's hourly counter (usuarios/{uid}/limites/likes),
    // and that counter must stay within the limit. The counter rules allow only +1 in the
    // current hour, or starting a new hour at 1.
    function limiteSubeEnEsteLote(uid) {
      let ruta = /databases/$(database)/documents/usuarios/$(uid)/limites/likes;
      let despues = getAfter(ruta).data;
      return despues.n <= maxLikesPorHora()
        && (!exists(ruta) || despues.n != get(ruta).data.n || despues.inicio != get(ruta).data.inicio);
    }

    function maxLikesPorHora() {
      let config = /databases/$(database)/documents/config/likes;
      return exists(config) ? get(config).data.get('maxPorHora', 60) : 60;
    }

    // Collection-group query of the app ("my likes in this centro"): only your own.
    match /{ruta=**}/likes/{liker} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Summarised catalogue by provincia, downloaded by the app on first launch.
    match /catalogo/{documento} {
      allow read: if true;
      allow write: if false;
    }

    // Featured reviews for Inicio, written by calcularDestacadas / recalcularDestacadas.
    // Only alias, role, note, excerpt and date of published reviews; no uid.
    match /destacadas/{documento} {
      allow read: if true;
      allow write: if false;
    }

    // App configuration (e.g. config/departamentos, config/destacadas): public read.
    match /config/{documento} {
      allow read: if true;
      allow write: if false;
    }

    // User profile. The user creates it at sign-up as ESTUDIANTE or OTRO, unverified and
    // 14+. rol = DOCENTE and verificado are
    // written only by the backend (Admin SDK), after the teacher verification (doc 04).
    // The birth date is not stored, only mayorDe14 (data minimisation, GDPR).
    match /usuarios/{uid} {
      function esPropio() {
        return request.auth != null && request.auth.uid == uid;
      }
      function aliasValido(alias) {
        return alias is string && alias.size() >= 3 && alias.size() <= 30;
      }
      // Administrators read profiles to review teacher verifications (alias, fechaAlta).
      allow read: if esPropio() || esAdmin();
      // Version of the terms of use in force (web/condiciones.html). Keep in step with
      // functions/src/condiciones.ts and the app (domain/model/Condiciones.kt).
      function condicionesVigentes() {
        return '2026-11';
      }
      allow create: if esPropio()
        && request.resource.data.keys().hasOnly(['alias', 'rol', 'verificado', 'mayorDe14', 'fechaAlta', 'condiciones'])
        && request.resource.data.keys().hasAll(['alias', 'rol', 'verificado', 'mayorDe14', 'fechaAlta', 'condiciones'])
        && request.resource.data.condiciones == condicionesVigentes()
        && aliasValido(request.resource.data.alias)
        && request.resource.data.rol in ['ESTUDIANTE', 'OTRO']
        && request.resource.data.verificado == false
        && request.resource.data.mayorDe14 == true
        && request.resource.data.fechaAlta == request.time;
      // Afterwards: alias, and rol only between ESTUDIANTE and OTRO (never to or from
      // DOCENTE). Reviews already written keep their rolAutor.
      // Afterwards: alias, accepting the terms in force, and rol only between ESTUDIANTE and OTRO.
      allow update: if esPropio()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alias', 'rol', 'condiciones'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['condiciones'])
            || request.resource.data.condiciones == condicionesVigentes())
        && aliasValido(request.resource.data.alias)
        && (request.resource.data.rol == resource.data.rol
            || (resource.data.rol in ['ESTUDIANTE', 'OTRO']
                && request.resource.data.rol in ['ESTUDIANTE', 'OTRO']));
      // Account deletion (Google Play / GDPR).
      allow delete: if esPropio();

      // Favourites: only the owner. The document id is the centro code (the app keeps
      // at most 100; alBorrarUsuario deletes them with the account).
      match /favoritos/{codigo} {
        allow read, delete: if esPropio();
        allow create: if esPropio()
          && codigo.matches('[0-9]{8}')
          && request.resource.data.keys().hasOnly(['codigo', 'fecha'])
          && request.resource.data.codigo == codigo
          && request.resource.data.fecha == request.time;
        allow update: if false;
      }

      // Blocked authors (Play's user-generated content policy): the user stops seeing their
      // reviews. Only the owner; the id is the author's uid; alBorrarUsuario deletes them.
      match /bloqueados/{autor} {
        allow read, delete: if esPropio();
        // alias: the author's public alias, only to show the list in Mi cuenta.
        allow create: if esPropio() && autor != uid
          && request.resource.data.keys().hasOnly(['fecha', 'alias'])
          && request.resource.data.keys().hasAll(['fecha', 'alias'])
          && request.resource.data.fecha == request.time
          && request.resource.data.alias is string && request.resource.data.alias.size() <= 30;
        allow update: if false;
      }

      // Hourly likes counter { inicio, n }: +1 within the hour, or a new hour starting at 1.
      // It cannot be deleted or reset early (alBorrarUsuario deletes it with the account).
      match /limites/{limite} {
        function horaTerminada() {
          return request.time >= resource.data.inicio + duration.value(1, 'h');
        }
        function forma() {
          return limite == 'likes'
            && request.resource.data.keys().hasOnly(['inicio', 'n'])
            && request.resource.data.keys().hasAll(['inicio', 'n']);
        }
        allow read: if esPropio();
        allow create: if esPropio() && forma()
          && request.resource.data.inicio == request.time && request.resource.data.n == 1;
        allow update: if esPropio() && forma() && (
          (horaTerminada() && request.resource.data.inicio == request.time && request.resource.data.n == 1)
          || (!horaTerminada() && request.resource.data.inicio == resource.data.inicio
              && request.resource.data.n == resource.data.n + 1));
        allow delete: if false;
      }
    }

    // Moderation panel: administrators read reviews in any state across centros
    // (collection-group query on estado == EN_REVISION).
    match /{ruta=**}/valoraciones/{uid} {
      allow read: if esAdmin();
    }

    // Reports: written only by denunciarValoracion / moderarValoracion; administrators read them.
    match /denuncias/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Teacher verification (doc 04). Written only by the functions solicitarVerificacion,
    // resolverVerificacion and caducarVerificaciones. The user reads their own status;
    // administrators read everything.
    match /verificaciones/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || esAdmin();
      allow write: if false;

      // Declared name, plain CSV and PDF path: only administrators, and only while the
      // request is pending (deleted when it is resolved or expires).
      match /privado/{documento} {
        allow read: if esAdmin();
        allow write: if false;
      }
    }

    // Everything else (favoritos, denuncias, csvUsados…) stays
    // closed until its phase defines the rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
