rules_version = '2';

// Valoralo — Firestore security rules (docs/02-arquitectura-y-datos.md).
// The catalogue, stats, rol and verificado are written only by the backend
// (Admin SDK / Cloud Functions), which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrators carry the custom claim admin = true (tools/admin/hacer_admin.py).
    function esAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Catalogue of centros, including stats: public read, no client writes.
    match /centros/{codigo} {
      allow read: if true;
      allow write: if false;

      // Reviews: anyone can read the published ones (queries must filter by
      // estado == "PUBLICADA"); the author can also read their own while it is under
      // review. They are written only by the publicarValoracion function (filter, role
      // from the profile); the author can delete their own.
      match /valoraciones/{uid} {
        allow read: if resource.data.estado == "PUBLICADA"
          || (request.auth != null && request.auth.uid == uid);
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if false;
      }
    }

    // Summarised catalogue by provincia, downloaded by the app on first launch.
    match /catalogo/{documento} {
      allow read: if true;
      allow write: if false;
    }

    // App configuration (e.g. config/departamentos): public read.
    match /config/{documento} {
      allow read: if true;
      allow write: if false;
    }

    // User profile. The user creates it at sign-up as ESTUDIANTE or OTRO, unverified and
    // 14+. rol = DOCENTE and verificado are
    // written only by the backend (Admin SDK), after the teacher verification (doc 04).
    // The birth date is not stored, only mayorDe14 (data minimisation, GDPR).
    match /usuarios/{uid} {
      function esPropio() {
        return request.auth != null && request.auth.uid == uid;
      }
      function aliasValido(alias) {
        return alias is string && alias.size() >= 3 && alias.size() <= 30;
      }
      // Administrators read profiles to review teacher verifications (alias, fechaAlta).
      allow read: if esPropio() || esAdmin();
      allow create: if esPropio()
        && request.resource.data.keys().hasOnly(['alias', 'rol', 'verificado', 'mayorDe14', 'fechaAlta'])
        && request.resource.data.keys().hasAll(['alias', 'rol', 'verificado', 'mayorDe14', 'fechaAlta'])
        && aliasValido(request.resource.data.alias)
        && request.resource.data.rol in ['ESTUDIANTE', 'OTRO']
        && request.resource.data.verificado == false
        && request.resource.data.mayorDe14 == true
        && request.resource.data.fechaAlta == request.time;
      // Afterwards: alias, and rol only between ESTUDIANTE and OTRO (never to or from
      // DOCENTE). Reviews already written keep their rolAutor.
      allow update: if esPropio()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alias', 'rol'])
        && aliasValido(request.resource.data.alias)
        && (request.resource.data.rol == resource.data.rol
            || (resource.data.rol in ['ESTUDIANTE', 'OTRO']
                && request.resource.data.rol in ['ESTUDIANTE', 'OTRO']));
      // Account deletion (Google Play / GDPR).
      allow delete: if esPropio();

      // Favourites: only the owner. The document id is the centro code (the app keeps
      // at most 100; alBorrarUsuario deletes them with the account).
      match /favoritos/{codigo} {
        allow read, delete: if esPropio();
        allow create: if esPropio()
          && codigo.matches('[0-9]{8}')
          && request.resource.data.keys().hasOnly(['codigo', 'fecha'])
          && request.resource.data.codigo == codigo
          && request.resource.data.fecha == request.time;
        allow update: if false;
      }
    }

    // Moderation panel: administrators read reviews in any state across centros
    // (collection-group query on estado == EN_REVISION).
    match /{ruta=**}/valoraciones/{uid} {
      allow read: if esAdmin();
    }

    // Reports: written only by denunciarValoracion / moderarValoracion; administrators read them.
    match /denuncias/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Teacher verification (doc 04). Written only by the functions solicitarVerificacion,
    // resolverVerificacion and caducarVerificaciones. The user reads their own status;
    // administrators read everything.
    match /verificaciones/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || esAdmin();
      allow write: if false;

      // Declared name, plain CSV and PDF path: only administrators, and only while the
      // request is pending (deleted when it is resolved or expires).
      match /privado/{documento} {
        allow read: if esAdmin();
        allow write: if false;
      }
    }

    // Everything else (favoritos, denuncias, csvUsados…) stays
    // closed until its phase defines the rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
